{
  "name": "valdermoor-dm",
  "private": true,
  "version": "1.1.2",
  "description": "Valdermoor — D&D KI-Dungeon-Master",
  "author": "Ben Hofstetter <278487459+genben-sb3@users.noreply.github.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build:win": "npm run build && electron-builder --win --publish always",
    "electron:build:mac": "npm run build && electron-builder --mac --publish always",
    "electron:build:linux": "npm run build && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "electron-updater": "^6.8.3",
    "pdfjs-dist": "^5.6.205"
  },
  "build": {
    "appId": "app.valdermoor.dm",
    "productName": "Valdermoor",
    "copyright": "Copyright © 2026 Ben Hofstetter",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Valdermoor-Setup.${ext}",
      "publisherName": "Ben Hofstetter"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": "Spiele",
      "shortcutName": "Valdermoor",
      "uninstallDisplayName": "Valdermoor",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "Valdermoor.${ext}",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "artifactName": "Valdermoor.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "genben-sb3",
        "repo": "valdermoor"
      }
    ]
  }
}
